# ─────────────────────────────────────────────────────────────────────────────
# DailySpend — Environment Variables Template
#
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5432/dailyspend
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=yourpassword

# JWT Authentication
# Use a long, random string (minimum 32 characters) for production
JWT_SECRET=replace-this-with-a-very-long-and-random-secret-key
JWT_EXPIRATION=864000000
